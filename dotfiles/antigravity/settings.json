{
    // ================================
    // 🎨 WORKBENCH & WINDOW
    // ================================
    "workbench": {
        "colorTheme": "GitHub Light",
        "preferredDarkColorTheme": "GitHub Light",
        "iconTheme": "material-icon-theme",
        "productIconTheme": "material-product-icons",
        "statusBar": {
            "visible": false,
        },
        "tips": {
            "enabled": false,
        },
        "tree": {
            "enableStickyScroll": true,
            "indent": 14,
            "renderIndentGuides": "onHover",
        },
        "sideBar": {
            "location": "right",
        },
        "editor": {
            "enablePreview": true,
            "enablePreviewFromQuickOpen": false,
            "closeEmptyGroups": false,
            "tabSizing": "shrink",
            "tabActionCloseVisibility": false,
            "stickyScroll": {
                "enabled": true,
            },
            "guides": {
                "indentation": true,
                "highlightActiveIndentation": false,
                "bracketPairs": "active",
            },
            "bracketPairColorization": {
                "enabled": true,
            },
            "matchBrackets": "never",
            "renderLineHighlight": "none",
            "renderWhitespace": "trailing",
            "parameterHints": {
                "enabled": false,
            },
            "inlayHints": {
                "enabled": "off",
            },
            "inlineSuggest": {
                "enabled": true,
            },
            "linkedEditing": true,
            "codeLens": true,
            "glyphMargin": true,
            "foldingHighlight": true,
            "lineNumbers": "relative",
            "multiCursorModifier": "alt",
            "multiCursorMergeOverlapping": false,
            "padding": {
                "top": 14,
                "bottom": 14,
            },
            "editorActionsLocation": "titleBar",
            "showFoldingControls": "always",
            "showUnused": true,
            "suggestSelection": "first",
            "wordSeparators": "`~!@#$%^&*()-=+[{]},;:'\",.<>/?\\|_",
            "dragAndDrop": true,
            "snippetsPreventQuickSuggestions": false,
            "snippets": {
                "preventQuickSuggestions": false,
            },
            "empty": {
                "hint": "hidden",
            },
        },
        "zenMode": {
            "centerLayout": true,
            "hideTabs": true,
            "hideStatusBar": true,
            "hideActivityBar": true,
            "fullScreen": false,
        },
        "layoutControl": {
            "enabled": true,
        },
        "list": {
            "multiSelectModifier": "alt",
            "smoothScrolling": true,
        },
        "startupEditor": "none",
        "commandPalette": {
            "experimental": {
                "enableNaturalLanguageSearch": true,
            },
        },
    },
    "window": {
        "title": "${activeEditorShort}${separator}${rootName}${separator}${appName}",
        "titleSeparator": " | ",
        "titleBarStyle": "custom",
        "nativeTabs": false,
        "newWindowDimensions": "inherit",
        "restoreFullscreen": true,
        "zoomLevel": 0,
        "openFilesInNewWindow": "off",
        "openFoldersInNewWindow": "off",
        "openWithoutArgumentsInNewWindow": "off",
        "enableMenuBarMnemonics": true,
        "enableMenuBarAccessKeys": true,
        "autoDetectColorScheme": true,
        "customMenuBarAltFocus": true,
        "menuBarVisibility": "toggle",
        "autoDetectHighContrast": false,
        "newWindowProfile": "Default",
        "commandCenter": true,
    },
    "files": {
        "autoSave": "afterDelay",
        "autoSaveDelay": 1000,
        "trimTrailingWhitespace": true,
        "insertFinalNewline": true,
        "trimFinalNewlines": true,
        "defaultLanguage": "",
        "associations": {
            "*.js": "javascriptreact",
            "*.jsx": "javascriptreact",
            "*.ts": "typescriptreact",
            "*.tsx": "typescriptreact",
        },
    },
    "security": {
        "workspace": {
            "trust": {
                "enabled": true,
                "untrustedFiles": "open",
            },
        },
        "file": {
            "enable": true,
        },
    },
    "editor": {
        "accessibilitySupport": "off",
        "fontFamily": "JetBrainsMono Nerd Font, Consolas, 'Courier New', monospace",
        "fontSize": 18,
        "lineHeight": 26,
        "fontLigatures": true,
        "fontWeight": "500",
        "wordWrap": "on",
        "smoothScrolling": true,
        "cursorSmoothCaretAnimation": "on",
        "cursorBlinking": "smooth",
        "cursorStyle": "line",
        "mouseWheelZoom": true,
        "unicodeHighlight": {
            "nonBasicASCII": false,
            "ambiguousCharacters": false,
            "invisibleCharacters": true,
        },
        "minimap": {
            "enabled": false,
            "side": "right",
            "showSlider": "always",
            "renderCharacters": false,
            "scale": 1,
            "maxColumn": 120,
        },
        "multiCursorMergeOverlapping": false,
        "formatOnPaste": true,
        "formatOnSave": false,
        "suggest": {
            "preview": true,
            "insertMode": "replace",
            "showStatusBar": true,
        },
        "quickSuggestions": {
            "other": "on",
            "comments": "off",
            "strings": "on",
        },
        "parameterHints": {
            "enabled": false,
        },
        "inlayHints": {
            "enabled": "off",
            "fontSize": 14,
            "fontFamily": "JetBrainsMono Nerd Font, Consolas, 'Courier New', monospace",
            "fontWeight": "500",
        },
        "codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit",
        },
        "scrollbar": {
            "vertical": "visible",
            "horizontal": "hidden",
            "verticalScrollbarSize": 10,
            "horizontalScrollbarSize": 10,
            "arrowSize": 12,
            "useShadows": true,
        },
        "overviewRulerBorder": true,
        "wordBasedSuggestions": "matchingDocuments",
    },
    "diffEditor": {
        "ignoreTrimWhitespace": false,
        "renderSideBySide": true,
        "experimental": {
            "showMoves": true,
        },
    },
    "terminal": {
        "fontFamily": "JetBrainsMono Nerd Font, 'Hack Nerd Font'",
        "fontSize": 18,
        "lineHeight": 1,
        "cursorBlinking": true,
        "cursorStyle": "underline",
        "cursorWidth": 2,
        "integrated": {
            "scrollback": 10000,
            "cursorBlinking": true,
            "cursorStyle": "underline",
            "cursorWidth": 2,
            "fontFamily": "JetBrainsMono Nerd Font, 'Hack Nerd Font'",
            "fontSize": 18,
            "lineHeight": 1,
            "smoothScrolling": true,
            "gpuAcceleration": "auto",
            "enableImages": true,
            "defaultProfile": {
                "windows": "PowerShell",
                "linux": "zsh",
                "osx": "zsh",
            },
            "cursorStyleInactive": "underline",
            "autoReplies": {
                "Terminate batch job (Y/N)": "Y\r",
                "Terminate batch job (Y/n)": "Y\r",
            },
        },
    },
    "breadcrumbs": {
        "enabled": true,
        "filePath": "on",
        "symbolPath": "on",
    },
    "python": {
        "defaultInterpreterPath": "/usr/bin/python3",
        "linting": {
            "enabled": true,
            "pylintEnabled": true,
            "flake8Enabled": false,
            "mypyEnabled": false,
            "banditEnabled": false,
            "prospectorEnabled": false,
            "pydocstyleEnabled": false,
            "pycodestyleEnabled": false,
            "formatting": {
                "provider": "black",
            },
        },
    },
    "[python]": {
        "editor": {
            "formatOnSave": true,
            "defaultFormatter": "ms-python.black-formatter",
            "codeActionsOnSave": {
                "source": {
                    "fixAll": "explicit",
                    "organizeImports": "explicit",
                },
            },
            "rulers": [
                {
                    "column": 72,
                    "color": "#684e4e",
                },
                {
                    "column": 79,
                    "color": "#4b5c59",
                },
            ],
        },
    },
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[scss]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features",
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features",
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[markdown]": {
        "editor.wordWrap": "on",
        "editor.quickSuggestions": {
            "other": "off",
            "comments": "off",
            "strings": "off",
        },
        "files.trimTrailingWhitespace": false,
    },
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml",
    },
    "git": {
        "enableSmartCommit": true,
        "enableCommitSigning": true,
        "autofetch": true,
        "confirmSync": false,
        "decorations.enabled": false,
        "openRepositoryInParentFolders": "always",
    },
    "scm.defaultViewMode": "tree",
    "explorer": {
        "confirmDragAndDrop": false,
        "confirmDelete": false,
        "openEditors.visible": 1,
        "autoReveal": false,
        "compactFolders": false,
        "fileNesting": {
            "enabled": true,
            "expand": false,
            "patterns": {
                "*.ts": "${capture}.js",
                "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
                "*.jsx": "${capture}.js",
                "*.tsx": "${capture}.ts",
                "tsconfig.json": "tsconfig.*.json",
                "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, .npmrc, .yarnrc.yml",
                "Cargo.toml": "Cargo.lock",
                ".env": ".env.*",
                ".gitignore": ".gitattributes, .gitmodules, .mailmap",
                "README.md": "LICENSE, CHANGELOG.md, CONTRIBUTING.md, CODE_OF_CONDUCT.md",
                "Dockerfile": "docker-compose.yml, docker-compose.*.yml, .dockerignore",
                "*.sqlite": "${capture}.${extname}-*",
                "*.db": "${capture}.${extname}-*",
            },
        },
        "confirmPasteNative": false,
    },
    // ================================
    // ⚙️ DEVELOPMENT & TOOLING
    // ================================
    "remote.defaultExtensionsIfInstalledLocally": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "GitHub.vscode-pull-request-github",
    ],
    "cSpell.userWords": [
        "burpsuite",
        "dotfiles",
        "hashlib",
        "mainfile",
        "psutil",
        "pynput",
        "raddr",
        "thunar",
        "wezterm",
    ],
    "indentRainbow": {
        "enabled": true,
        "indicatorStyle": "light",
        "lightIndicatorStyleLineWidth": 1,
        "colors": [
            "rgba(255,255,64,0.3)",
            "rgba(127,255,127,0.3)",
            "rgba(255,127,255,0.3)",
            "rgba(79,236,236,0.3)",
            "rgba(255,127,127,0.3)",
            "rgba(127,127,255,0.3)",
            "rgba(255,255,127,0.3)",
            "rgba(127,255,255,0.3)",
        ],
    },
    "glassit.alpha": 255,
    "resmon.show.cputemp": true,
    "apc.stylesheet": {
        ".quick-input-widget": {
            "transform": "translateY(-50%) !important",
            "top": "50% !important",
        },
    },
    "database-client.autoSync": true,
    "snyk.advanced.cliPath": "C:\\Users\\nyx\\AppData\\Local\\snyk\\vscode-cli\\snyk-win.exe",
}
