{
    // ================================
    // 🎨 WORKBENCH & WINDOW
    // ================================
    "workbench.colorTheme": "Hack The Box",
    "workbench.iconTheme": "material-icon-theme",
    "workbench.productIconTheme": "material-product-icons",
    "workbench.statusBar.visible": false,
    "workbench.tips.enabled": false,
    "workbench.tree.enableStickyScroll": true,
    "workbench.sideBar.location": "right",
    "workbench.editor.enablePreview": true,
    "workbench.editor.enablePreviewFromQuickOpen": false,
    "workbench.editor.closeEmptyGroups": false,
    "workbench.editor.tabSizing": "shrink",
    "workbench.editor.tabActionCloseVisibility": false,
    "workbench.layoutControl.enabled": true,
    "workbench.tree.indent": 14,
    "workbench.tree.renderIndentGuides": "onHover",
    "workbench.editor.editorActionsLocation": "titleBar",
    "workbench.list.multiSelectModifier": "alt",
    "workbench.list.smoothScrolling": true,
    "workbench.startupEditor": "none",
    "workbench.commandPalette.experimental.enableNaturalLanguageSearch": true,
    "workbench.editor.empty.hint": "hidden",
    "window.menuBarVisibility": "toggle",
    "window.titleSeparator": " | ",
    "window.autoDetectHighContrast": false,
    "window.newWindowProfile": "Default",
    "window.commandCenter": true,
    // ================================
    // 📁 FILES & WORKSPACE
    // ================================
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.defaultLanguage": "",
    "security.workspace.trust.untrustedFiles": "open",
    // ================================
    // ✍️ EDITOR BEHAVIOR & AESTHETICS
    // ================================
    "editor.fontFamily": "JetBrainsMono Nerd Font, Consolas, 'Courier New', monospace",
    "editor.fontSize": 18,
    "editor.lineHeight": 26,
    "editor.fontLigatures": true,
    "editor.fontWeight": "500",
    "editor.wordWrap": "on",
    "editor.smoothScrolling": true,
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorBlinking": "smooth",
    "editor.cursorStyle": "line",
    "editor.mouseWheelZoom": true,
    "editor.accessibilitySupport": "off",
    "editor.unicodeHighlight.nonBasicASCII": false,
    "editor.minimap.enabled": false,
    "editor.stickyScroll.enabled": true,
    "editor.guides.indentation": true,
    "editor.guides.highlightActiveIndentation": false,
    "editor.guides.bracketPairs": "active",
    "editor.bracketPairColorization.enabled": true,
    "editor.matchBrackets": "never",
    "editor.renderLineHighlight": "none",
    "editor.renderWhitespace": "trailing",
    "editor.parameterHints.enabled": false,
    "editor.inlayHints.enabled": "off",
    "editor.inlineSuggest.enabled": true,
    "editor.linkedEditing": true,
    "editor.codeLens": false,
    "editor.glyphMargin": false,
    "editor.foldingHighlight": false,
    "editor.lineNumbers": "relative",
    "editor.multiCursorModifier": "alt",
    "editor.multiCursorMergeOverlapping": false,
    "editor.padding.top": 14,
    "editor.padding.bottom": 14,
    "editor.formatOnPaste": true,
    "editor.formatOnSave": false,
    "editor.suggest.preview": true,
    "editor.suggest.insertMode": "replace",
    "editor.suggest.showStatusBar": true,
    "editor.quickSuggestions": {
        "other": "on",
        "comments": "off",
        "strings": "on"
    },
    "breadcrumbs.enabled": true,
    "editor.scrollbar.horizontal": "hidden",
    "editor.scrollbar.verticalScrollbarSize": 10,
    "editor.scrollbar.horizontalScrollbarSize": 10,
    "editor.overviewRulerBorder": true,
    "editor.wordBasedSuggestions": "matchingDocuments",
    // ================================
    // 🔀 DIFF EDITOR
    // ================================
    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.renderSideBySide": true,
    "diffEditor.experimental.showMoves": true,
    // ================================
    // 🖥️ TERMINAL
    // ================================
    "terminal.integrated.gpuAcceleration": "on",
    "terminal.integrated.enableImages": true,
    "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font, 'Hack Nerd Font'",
    "terminal.integrated.fontSize": 16,
    "terminal.integrated.cursorStyle": "underline",
    "terminal.integrated.cursorStyleInactive": "underline",
    "terminal.integrated.cursorWidth": 2,
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.lineHeight": 1,
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.autoReplies": {
        "Terminate batch job (Y/N)": "Y\r",
        "Terminate batch job (Y/n)": "Y\r"
    },
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    // ================================
    // 🐍 LANGUAGE-SPECIFIC SETTINGS
    // ================================
    "[python]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
        },
        "editor.rulers": [
            {
                "column": 72,
                "color": "#684e4e"
            },
            {
                "column": 79,
                "color": "#4b5c59"
            }
        ]
    },
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[scss]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[markdown]": {
        "editor.wordWrap": "on",
        "editor.quickSuggestions": {
            "other": "off",
            "comments": "off",
            "strings": "off"
        },
        "files.trimTrailingWhitespace": false
    },
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    // ================================
    // 🧩 EXTENSIONS & SOURCE CONTROL
    // ================================
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.decorations.enabled": false,
    "git.openRepositoryInParentFolders": "always",
    "scm.defaultViewMode": "tree",
    "explorer.autoReveal": false,
    "explorer.compactFolders": false,
    "explorer.openEditors.visible": 1,
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmPasteNative": false,
    "explorer.confirmDelete": false,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, .npmrc, .yarnrc.yml",
        "Cargo.toml": "Cargo.lock",
        ".env": ".env.*",
        ".gitignore": ".gitattributes, .gitmodules, .mailmap",
        "README.md": "LICENSE, CHANGELOG.md, CONTRIBUTING.md, CODE_OF_CONDUCT.md",
        "Dockerfile": "docker-compose.yml, docker-compose.*.yml, .dockerignore",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*"
    },
    // ================================
    // ⚙️ DEVELOPMENT & TOOLING
    // ================================
    "remote.defaultExtensionsIfInstalledLocally": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "GitHub.vscode-pull-request-github"
    ],
    "cSpell.userWords": [
        "burpsuite",
        "dotfiles",
        "hashlib",
        "mainfile",
        "psutil",
        "pynput",
        "raddr",
        "thunar",
        "wezterm"
    ],
    // ================================
    // 🔮 COSMETICS & UI TWEAKS
    // ================================
    "indentRainbow.indicatorStyle": "light",
    "indentRainbow.lightIndicatorStyleLineWidth": 1,
    "indentRainbow.colors": [
        "rgba(255,255,64,0.3)",
        "rgba(127,255,127,0.3)",
        "rgba(255,127,255,0.3)",
        "rgba(79,236,236,0.3)"
    ],
    "glassit.alpha": 255,
    "resmon.show.cputemp": true,
    "apc.stylesheet": {
        ".quick-input-widget": {
            "transform": "translateY(-50%) !important",
            "top": "50% !important"
        }
    },
    "database-client.autoSync": true
}
