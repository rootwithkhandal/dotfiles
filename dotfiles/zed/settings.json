{
    // ================================
    // 🎨 THEME & APPEARANCE
    // ================================
    "edit_predictions": {
        "provider": "zed"
    },
    "icon_theme": "Material Icon Theme",
    "theme": {
        "mode": "dark",
        "light": "Monosami Light",
        "dark": "Monosami Dark"
    },
    "theme_overrides": {
        "Aura Dark": {
            "editor.document_highlight.read_background": "#00000000",
            "editor.document_highlight.write_background": "#00000000",
            "editor.active_line.background": "#15141C",
            "border": "#15141C",
            "border.variant": "#15141C",
            "title_bar.background": "#15141C",
            "panel.background": "#15141C",
            "pane.focused_border": "#4E466E",
            "players": [
                {
                    "cursor": "#bd9dff"
                }
            ],
            "syntax": {
                "comment": {
                    "font_style": "italic"
                },
                "comment.doc": {
                    "font_style": "italic"
                }
            }
        }
    },
    "current_line_highlight": "line",
    // ================================
    // ✍️ EDITOR & FONTS
    // ================================
    "ui_font_family": "SF Pro Display",
    "ui_font_size": 16,
    "buffer_font_family": "JetBrainsMonoNL Nerd Font Mono",
    "buffer_font_size": 18,
    "buffer_font_weight": 500,
    // "vim_mode": true,
    "buffer_line_height": "comfortable",
    "cursor_blink": true,
    "cursor_shape": "bar",
    "show_whitespaces": "boundary",
    "soft_wrap": "preferred_line_length",
    "preferred_line_length": 100,
    "show_wrap_guides": true,
    "use_autoclose": true,
    "always_treat_brackets_as_autoclosed": true,
    "show_completions_on_input": true,
    "show_completion_documentation": true,
    "completion_documentation_secondary_query_debounce": 300,
    "linked_edits": true,
    "extend_comment_on_newline": false,
    "format_on_save": "off",
    "close_on_file_delete": true,
    "restore_on_file_reopen": false,
    "when_closing_with_no_tabs": "keep_window_open",
    // ================================
    // 📁 FILES & WORKSPACE
    // ================================
    "autosave": {
        "after_delay": {
            "milliseconds": 1000
        }
    },
    "file_scan_exclusions": [
        "**/.git",
        "**/.svn",
        "**/.hg",
        "**/CVS",
        "**/.DS_Store",
        "**/Thumbs.db",
        "**/.classpath",
        "**/.settings",
        "**/node_modules",
        "**/__pycache__",
        "**/.venv",
        "**/venv",
        "**/.mypy_cache",
        "**/.pytest_cache",
        "**/dist",
        "**/build",
        "**/.next",
        "**/target"
    ],
    "restore_on_startup": "last_workspace",
    "session": {
        "restore_unsaved_buffers": false
    },
    "load_direnv": "direct",
    // ================================
    // 🧩 PANELS & UI LAYOUT
    // ================================
    "base_keymap": "VSCode",
    "title_bar": {
        "show_onboarding_banner": true,
        "show_branch_name": true,
        "show_project_items": true,
        "show_user_menu": true
    },
    "tab_bar": {
        "show": true
    },
    "tabs": {
        "close_position": "right",
        "file_icons": false,
        "git_status": false,
        "activate_on_close": "history",
        "show_close_button": "hover"
    },
    "toolbar": {
        "breadcrumbs": true,
        "quick_actions": true,
        "selections_menu": true
    },
    "status_bar": {
        "show": true
    },
    "gutter": {
        "min_line_number_digits": 0,
        // "line_numbers": "relative",
        "code_actions": true,
        "folds": false,
        "runnables": false
    },
    "indent_guides": {
        "enabled": false
    },
    "scrollbar": {
        "show": "never",
        "cursors": true,
        "git_diff": true,
        "search_results": true,
        "selected_symbol": true,
        "diagnostics": "all"
    },
    "minimap": {
        "show": "never"
    },
    "project_panel": {
        "dock": "right",
        "default_width": 400,
        "hide_root": true,
        "auto_fold_dirs": false,
        "starts_open": false,
        "git_status": true,
        "sticky_scroll": false,
        "scrollbar": {
            "show": "never"
        },
        "indent_guides": {
            "show": "true"
        }
    },
    "outline_panel": {
        "default_width": 300,
        "dock": "left",
        "indent_guides": {
            "show": "never"
        }
    },
    "collaboration_panel": {
        "dock": "right"
    },
    "notification_panel": {
        "dock": "right"
    },
    "chat_panel": {
        "dock": "right"
    },
    "file_finder": {
        "modal_max_width": "large"
    },
    // ================================
    // 🖥️ TERMINAL
    // ================================
    "terminal": {
        "shell": {
            "program": "powershell"
        },
        "alternate_scroll": "off",
        "blinking": "on",
        "copy_on_select": false,
        "dock": "right",
        "detect_venv": {
            "on": {
                "directories": [
                    ".env",
                    "env",
                    ".venv",
                    "venv"
                ],
                "activate_script": "default"
            }
        },
        "env": {},
        "font_family": "JetBrainsMonoNL Nerd Font Mono",
        "font_features": null,
        "font_size": 14,
        "line_height": "comfortable",
        "button": false,
        "toolbar": {
            "breadcrumbs": true
        },
        "working_directory": "current_project_directory"
    },
    // ================================
    // 🤖 AGENT & AI
    // ================================
    "agent": {
        "default_model": {
            "provider": "google",
            "model": "gemini-3-pro-preview"
        },
        "inline_assistant_model": {
            "provider": "ollama",
            "model": "codellama:7b"
        },
        "model_parameters": []
    },
    "inlay_hints": {
        "enabled": false
    },
    // ================================
    // 🔧 SOURCE CONTROL
    // ================================
    "git": {
        "git_gutter": "hide",
        "inline_blame": {
            "enabled": false
        }
    },
    // ================================
    // 🐍 LANGUAGE-SPECIFIC SETTINGS
    // ================================
    "languages": {
        "Python": {
            "format_on_save": "on",
            "formatter": "language_server",
            "preferred_line_length": 79,
            "soft_wrap": "preferred_line_length",
            "tab_size": 4
        },
        "JavaScript": {
            "formatter": "prettier",
            "tab_size": 2
        },
        "TypeScript": {
            "formatter": "prettier",
            "tab_size": 2
        },
        "TSX": {
            "formatter": "prettier",
            "tab_size": 2
        },
        "JSON": {
            "tab_size": 2
        },
        "JSONC": {
            "tab_size": 2
        },
        "HTML": {
            "formatter": "prettier",
            "tab_size": 2
        },
        "CSS": {
            "formatter": "prettier",
            "tab_size": 2
        },
        "SCSS": {
            "formatter": "prettier",
            "tab_size": 2
        },
        "Markdown": {
            "soft_wrap": "preferred_line_length",
            "preferred_line_length": 80,
            "show_whitespaces": "none",
            "format_on_save": "off"
        },
        "YAML": {
            "tab_size": 2
        },
        "TOML": {
            "tab_size": 2
        },
        "Rust": {
            "format_on_save": "on",
            "tab_size": 4
        },
        "Go": {
            "format_on_save": "on",
            "tab_size": 4,
            "hard_tabs": true
        }
    },
    // ================================
    // 📦 AUTO-INSTALL EXTENSIONS
    // ================================
    "auto_install_extensions": {
        "html": true,
        "dockerfile": true,
        "docker-compose": true,
        "toml": true,
        "git-firefly": true
    }
}
